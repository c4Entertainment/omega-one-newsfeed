        "services": {
            "title": "What we do",
            "note": "Six ways in",
            "items": [
                {
                    "icon": "tune",
                    "title": "Live sound",
                    "text": "Line array reinforcement — Martin Audio, Turbosound and Electro-Voice — rigged for halls and open grounds."
                },
                {
                    "icon": "bolt",
                    "title": "Stage and power",
                    "text": "Concert stage build and 130 kVA of generator on site, so the show does not stop with the grid."
                },
                {
                    "icon": "album",
                    "title": "Mobile disco",
                    "text": "The original business. Benga, ohangla and rumba, read off the floor by DJs who know the room."
                },
                {
                    "icon": "campaign",
                    "title": "Tours",
                    "text": "Systems hired to international bands playing the country."
                },
                {
                    "icon": "groups",
                    "title": "DJ development",
                    "text": "Don Ben, DJ Mike, Kim and Charley all learned the ropes here before moving on."
                },
                {
                    "icon": "mic",
                    "title": "Sound Check Studio (Closed)",
                    "text": "Tracking and mixing in Kisumu, in the room where Nyadundo and Onyi Papa Jay recorded."
